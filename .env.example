# Pflichtvariablen fuer Prisma / Build
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Pflichtvariablen fuer geschuetzten CRM-Produktivbetrieb
# Passwort: mindestens 12 Zeichen, stark und nur fuer den Studiozugang verwenden.
CRM_ADMIN_PASSWORD="REPLACE_WITH_LONG_UNIQUE_PASSWORD"
# Secret: mindestens 32 zufaellige Zeichen; Aenderung meldet alle bestehenden Sitzungen ab.
CRM_AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Optional: Stripe (nur falls aktiviert)
STRIPE_ACTIVE="false"
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"

# Optional: E2E-Tests gegen Live/Preview
E2E_BASE_URL="http://localhost:3000"

# Optional: CI-Override fuer Testlaeufe
CI="false"
